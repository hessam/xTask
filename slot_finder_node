            } else {
                console.log(`❌ Gap between events too small: ${gapStart.toLocaleTimeString()} - ${gapEnd.toLocaleTimeString()} (${duration} min < ${dynamicMinDuration} min)`);
            }
        }

        // After last event
        const lastEvent = dayEvents[dayEvents.length - 1];
        if (lastEvent.end < dayEnd) {
