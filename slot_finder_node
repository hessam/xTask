// STEP 1: Enhanced Intent Parsing
function parseUserIntent(originalMessage, task) {
    // FIX #2: Added a fallback `|| ""` to ensure `originalMessage` is always a string.
    // This acts as a safeguard against the error, even if the source of the undefined value isn't caught.
    const message = (originalMessage || "").toLowerCase();
    
    console.log('🔍 INTENT PARSING DEBUG:');
    console.log('Task object:', JSON.stringify(task, null, 2));
    console.log('Task.time value:', task.time, 'type:', typeof task.time);
    console.log('Task.due_date value:', task.due_date, 'type:', typeof task.due_date);
    console.log('!!task.time:', !!task.time);
    console.log('!!task.due_date:', !!task.due_date);
    
    const intent = {
        // Temporal markers
        isToday: /امروز|today|الان|now|امشب|tonight/.test(message),
        isTomorrow: /فردا|tomorrow/.test(message),
        isUrgent: /فوری|urgent|asap|زود|سریع|quick/.test(message),

        // Time specificity
        // FIX: The `NaN` error was caused here. The previous check `task.time !== null`
        // is insufficient because if the `time` property is missing entirely, its value
        // is `undefined`. `undefined !== null` evaluates to `true`, which incorrectly
        // told the script that a specific time or date was provided.
        // This led to an attempt to create a date from an invalid string (e.g., `new Date('undefinedT00:00:00')`),
        // resulting in an "Invalid Date" object that caused all subsequent calculations to return `NaN`.
        // UPDATED FIX: Also handle string "null" values from AI parsing
        hasSpecificTime: !!(task.time && task.time !== null && task.time !== "null" && task.time !== "undefined" && task.time.trim() !== ""),
        hasSpecificDate: !!(task.due_date && task.due_date !== null && task.due_date !== "null" && task.due_date !== "undefined" && task.due_date.trim() !== ""),

        // Context clues
        isEvening: /شب|عصر|evening|night/.test(message),
        isMorning: /صبح|morning/.test(message),
        isAfternoon: /بعدازظهر|afternoon|ظهر/.test(message),

        // Task nature
        isCreative: /محتوا|content|خلاق|creative|نوشت|write/.test(message),
        isMeeting: /جلسه|meeting|ملاقات/.test(message),
        isAdmin: /اداری|admin|form|فرم/.test(message),

        originalMessage: originalMessage
    };

    console.log('Parsed intent:', intent);
    return intent;
}

// STEP 2: Smart Target Date Logic
function determineTargetDate(task, intent) {
    const now = new Date();
    console.log(`Current date/time: ${now.toISOString()}`);
    console.log(`Current local time: ${now.toString()}`);

    // Explicit date requests take absolute priority
    if (intent.hasSpecificDate) {
        console.log('Using explicit due date:', task.due_date);
        const explicitDate = new Date(task.due_date + 'T00:00:00');
        console.log('Parsed explicit date:', explicitDate.toDateString());
        console.log('Explicit date day of week:', explicitDate.getDay());
        
        const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        console.log(`Explicit date is: ${dayNames[explicitDate.getDay()]}`);
        
        // CRITICAL: Check if explicit date is in the past
        if (explicitDate < now) {
            console.log('⚠️ EXPLICIT DATE IS IN THE PAST - interpreting as next occurrence');
            
            // Check if it's a day name that should be interpreted as "next Friday" etc.
            const originalMessage = intent.originalMessage || '';
            const dayPattern = /(friday|saturday|sunday|monday|tuesday|wednesday|thursday|جمعه|شنبه|یکشنبه|دوشنبه|سه‌شنبه|چهارشنبه|پنج‌شنبه)/i;
            const dayMatch = originalMessage.match(dayPattern);
            
            if (dayMatch) {
                const nextOccurrence = getNextOccurrenceOfDay(dayMatch[1], now);
                if (nextOccurrence) {
                    console.log(`📅 Corrected to next occurrence: ${nextOccurrence.toDateString()}`);
                    return nextOccurrence;
                }
            }
            
            // Fallback: add 7 days to get next week
            explicitDate.setDate(explicitDate.getDate() + 7);
            console.log(`📅 Fallback: moved to next week: ${explicitDate.toDateString()}`);
        }
        
        return explicitDate;
    }

    // "Today" enforcement - override time-based logic
    if (intent.isToday) {
        console.log('USER EXPLICITLY REQUESTED TODAY - enforcing same day');
        return now;
    }

    // "Tomorrow" enforcement
    if (intent.isTomorrow) {
        const tomorrow = new Date(now);
        tomorrow.setDate(tomorrow.getDate() + 1);
        console.log('User requested tomorrow');
        return tomorrow;
    }

    // Urgent tasks within 24 hours
    if (intent.isUrgent) {
        console.log('Urgent task - prioritizing immediate scheduling');
        return now;
    }

    // NEW: Smart postponement logic for quality-sensitive tasks
    const isQualitySensitive = isQualitySensitiveTask(task, intent);
    if (isQualitySensitive && !intent.isToday && !intent.isTomorrow) {
        console.log('🎯 QUALITY-SENSITIVE TASK - allowing flexible scheduling for optimal slots');
        // For quality-sensitive tasks, allow starting search from tomorrow 
        // to find better time slots rather than forcing poor today slots
        const tomorrow = new Date(now);
        tomorrow.setDate(tomorrow.getDate() + 1);
        return tomorrow;
    }

    // Default: only move to tomorrow if it's truly impractical (after 10 PM)
    if (now.getHours() >= 22) {
        console.log('Very late (after 10 PM) - defaulting to tomorrow');
        const tomorrow = new Date(now);
        tomorrow.setDate(tomorrow.getDate() + 1);
        return tomorrow;
    }

    // Standard case: start with today
    console.log('Starting with today as default');
    return now;
}

