function calculateContextSwitchingPenalty(gap, task, allEvents) {
    // Minimize context switching by analyzing surrounding events
    let penalty = 0;
    const taskCategory = task.category || 'general work';
    
    // Check events before and after this gap
    const gapStart = gap.start.getTime();
    const gapEnd = gap.end.getTime();
    
    // Find adjacent events within 2 hours
    const beforeEvents = allEvents.filter(e => {
        const eventEnd = new Date(e.end.dateTime || e.end.date).getTime();
        return eventEnd <= gapStart && (gapStart - eventEnd) <= 7200000; // 2 hours
    });
    
    const afterEvents = allEvents.filter(e => {
        const eventStart = new Date(e.start.dateTime || e.start.date).getTime();
        return eventStart >= gapEnd && (eventStart - gapEnd) <= 7200000; // 2 hours
    });
    
    // Analyze category mismatches
    [...beforeEvents, ...afterEvents].forEach(event => {
        const eventCategory = inferEventCategory(event.summary || '');
        if (eventCategory !== taskCategory) {
            penalty += 15; // Penalty for category switching
        }
    });
    
    return Math.min(penalty, 60); // Cap penalty at 60 points
}

function inferEventCategory(eventTitle) {
    // Smart category inference from event titles
    const title = eventTitle.toLowerCase();
    if (title.includes('meeting') || title.includes('call') || title.includes('standup')) return 'administrative';
    if (title.includes('code') || title.includes('dev') || title.includes('technical')) return 'technical work';
    if (title.includes('write') || title.includes('content') || title.includes('blog')) return 'content work';
    if (title.includes('learn') || title.includes('course') || title.includes('study')) return 'learning';
    if (title.includes('gym') || title.includes('workout') || title.includes('exercise')) return 'health';
    return 'general work';
}

function getUrgencyMultiplier(priority, daysUntilDue) {
    // Deadline pressure management with urgency scoring
    let urgencyScore = priority; // Base priority 1-10
    
    if (daysUntilDue <= 0) urgencyScore *= 3;      // Overdue: 3x multiplier
    else if (daysUntilDue <= 1) urgencyScore *= 2.5; // Due today/tomorrow: 2.5x
    else if (daysUntilDue <= 3) urgencyScore *= 2;   // Due this week: 2x
    else if (daysUntilDue <= 7) urgencyScore *= 1.5; // Due next week: 1.5x
    
    return Math.min(urgencyScore, 30); // Cap at 30 points
}

