// STEP 3: Task-Dependent Buffer Calculation
function calculateBuffer(task, intent, currentTime) {
    const now = currentTime || new Date();
    const hour = now.getHours();

    // Urgent override
    if (intent.isUrgent) {
        return 15; // Minimal buffer for urgent tasks
    }

    // High priority meetings
    if (task.priority >= 8 || intent.isMeeting) {
        return 15; // Just prep/wrap-up time
    }

    // Simple/short tasks
    if (task.complexity === 'simple' || task.estimated_duration <= 30) {
        return 30; // Quick transition
    }

    // Complex/creative tasks need mental shift time
    if (task.complexity === 'complex' || intent.isCreative) {
        return 60;
    }

    // Evening/early morning transitions need more time
    if (hour <= 7 || hour >= 20) {
        return 120; // Account for energy transitions
    }

    // Standard buffer for regular tasks
    return 30;
}

