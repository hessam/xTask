}

// STEP 5: Enhanced Gap Scoring
function scoreGap(gap, task, intent, preferredHours, targetDate) {
    let score = 0;
    const gapStartHour = gap.start.getHours();
    const gapEndHour = gap.end.getHours();

    // Size scoring (bigger gaps are more flexible)
    if (gap.duration >= 180) score += 30; // 3+ hour gaps
    else if (gap.duration >= 90) score += 20; // 1.5+ hour gaps
    else if (gap.duration >= 60) score += 10; // 1+ hour gaps

    // Time preference scoring
    for (let i = 0; i < preferredHours.length; i++) {
        const preferredHour = preferredHours[i];
        if (gapStartHour <= preferredHour && gapEndHour > preferredHour) {
            score += (20 - i * 3); // Higher score for earlier preferences
            break;
        }
    }

    // Gap type preferences
    if (gap.type === 'full_day') score += 25;
    else if (gap.type === 'between_events') score += 15;
    else if (gap.type === 'after_last') score += 10;
    else if (gap.type === 'before_first') score += 5;

    // CRITICAL FIX: Explicit due date priority bonus
    const gapDate = gap.start.toDateString();
    const targetDateStr = targetDate.toDateString();
    const isTargetDay = gapDate === targetDateStr;
    
    if (intent.hasSpecificDate && isTargetDay) {
        score += 100; // MASSIVE bonus for honoring explicit due date
        console.log(`🎯 EXPLICIT DATE BONUS: +100 for matching requested date ${targetDateStr}`);
    }

    // Same-day bonus for today requests
    if (intent.isToday && isTargetDay) {
        score += 50; // Major bonus for same-day scheduling
    }

    // Avoid very late or very early slots unless specifically requested
    if (gapStartHour < 8 && !intent.isMorning) score -= 15;
    if (gapStartHour >= 19 && !intent.isEvening) score -= 10;

    console.log(`Gap score: ${score} for ${gap.start.toLocaleTimeString()} - ${gap.end.toLocaleTimeString()} (${gap.type}) on ${gapDate}`);
    return score;
}

function createTimeSlotInUserTimezone(dateStr, timeStr, durationMinutes = 60) {
    const startTimeLocal = `${dateStr}T${timeStr}:00`;

    const [hours, minutes] = timeStr.split(':').map(Number);
    const totalMinutes = hours * 60 + minutes + durationMinutes;
    const endHours = Math.floor(totalMinutes / 60);
    const endMins = totalMinutes % 60;
    const endTimeLocal = `${dateStr}T${String(endHours).padStart(2, '0')}:${String(endMins).padStart(2, '0')}:00`;

    return {
        startTime: startTimeLocal,
        endTime: endTimeLocal,
        localStartTime: `${dateStr} ${timeStr}`,
        localEndTime: `${dateStr} ${String(endHours).padStart(2, '0')}:${String(endMins).padStart(2, '0')}`,
        timezone: userTimezone,
        duration: durationMinutes
    };
}

// Try to resolve time conflicts by adjusting ±1 hour
function tryResolveTimeConflict(conflictingSlot, events, task, dateStr, duration) {
    console.log('🔧 CONFLICT RESOLUTION: Trying to adjust time ±1 hour');
    console.log('🔧 Original conflicting slot:', conflictingSlot.startTime, 'to', conflictingSlot.endTime);
    console.log('🔧 Number of events to check against:', events.length);
    
    const originalTime = conflictingSlot.startTime.split('T')[1].substring(0, 5); // Extract "HH:MM"
    const [originalHour, originalMinute] = originalTime.split(':').map(Number);
    
    // Try adjusting by ±1 hour (earlier first, then later)
    const adjustments = [
        { hours: originalHour - 1, label: '1 hour earlier' },
        { hours: originalHour + 1, label: '1 hour later' }
    ];
    
    for (const adjustment of adjustments) {
        // Validate hour is within reasonable bounds (7 AM to 10 PM)
        if (adjustment.hours < 7 || adjustment.hours > 22) {
            console.log(`⏭️ Skipping ${adjustment.label} - outside working hours (${adjustment.hours}:${originalMinute})`);
            continue;
        }
        
        const adjustedTimeStr = `${String(adjustment.hours).padStart(2, '0')}:${String(originalMinute).padStart(2, '0')}`;
        console.log(`🔍 Testing ${adjustment.label}: ${adjustedTimeStr}`);
        
        const adjustedSlot = createTimeSlotInUserTimezone(dateStr, adjustedTimeStr, duration);
        console.log(`🔍 Created test slot: ${adjustedSlot.startTime} to ${adjustedSlot.endTime}`);
        
        const hasConflictResult = hasConflict(adjustedSlot, events);
        const isInPast = isSlotInPast(adjustedSlot, 0); // No buffer for conflict resolution
        console.log(`🔍 Conflict check result: ${hasConflictResult}`);
        console.log(`🔍 Past check result: ${isInPast}`);
        
        if (!hasConflictResult && !isInPast) {
            console.log(`✅ CONFLICT RESOLVED: ${adjustment.label} works (${adjustedTimeStr})`);
            return adjustedSlot;
        } else {
            const reasons = [];
            if (hasConflictResult) reasons.push('conflicts');
            if (isInPast) reasons.push('in past');
            console.log(`❌ ${adjustment.label} rejected: ${reasons.join(', ')} (${adjustedTimeStr})`);
            if (adjustedSlot.conflictDetails) {
                console.log(`❌ Conflicting with:`, adjustedSlot.conflictDetails.map(c => c.eventTitle));
            }
        }
    }
    
    console.log('❌ CONFLICT UNRESOLVABLE: No suitable ±1 hour adjustment found');
    return null;
}

function findAvailableGaps(events, targetDateStr, minDuration = 30) {
    console.log(`Finding gaps for ${targetDateStr} (min duration: ${minDuration}min)`);

    const dayEvents = events
        .filter(event => {
            if (!event.start || !event.start.dateTime) return false;
            const eventDate = event.start.dateTime.split('T')[0];
            return eventDate === targetDateStr;
        })
        .map(event => ({
            start: new Date(event.start.dateTime),
            end: new Date(event.end.dateTime),
            summary: event.summary
        }))
        .sort((a, b) => a.start - b.start);

    console.log(`Events on ${targetDateStr}:`, dayEvents.map(e => `${e.summary}: ${e.start.toLocaleTimeString()} - ${e.end.toLocaleTimeString()}`));

    const gaps = [];
    const workingHours = {
        start: 7,
        end: 22
    };
    const dayStart = new Date(`${targetDateStr}T${String(workingHours.start).padStart(2, '0')}:00:00`);
    const dayEnd = new Date(`${targetDateStr}T${String(workingHours.end).padStart(2, '0')}:00:00`);

    console.log(`Working hours: ${dayStart.toLocaleTimeString()} - ${dayEnd.toLocaleTimeString()}`);

    if (dayEvents.length === 0) {
        gaps.push({
            start: dayStart,
            end: dayEnd,
            duration: (dayEnd - dayStart) / (1000 * 60),
            type: 'full_day'
        });
        console.log(`Full day available: ${dayStart.toLocaleTimeString()} - ${dayEnd.toLocaleTimeString()} (${(dayEnd - dayStart) / (1000 * 60)} min)`);
    } else {
        // Before first event
        if (dayEvents[0].start > dayStart) {
            const duration = (dayEvents[0].start - dayStart) / (1000 * 60);
            if (duration >= minDuration) {
                gaps.push({
                    start: dayStart,
                    end: dayEvents[0].start,
                    duration: duration,
                    type: 'before_first'
                });
                console.log(`Gap before first event: ${dayStart.toLocaleTimeString()} - ${dayEvents[0].start.toLocaleTimeString()} (${duration} min)`);
            }
        }

        // Between events
        for (let i = 0; i < dayEvents.length - 1; i++) {
            const gapStart = dayEvents[i].end;
            const gapEnd = dayEvents[i + 1].start;
            const duration = (gapEnd - gapStart) / (1000 * 60);

            if (duration >= minDuration) {
                gaps.push({
                    start: gapStart,
                    end: gapEnd,
                    duration: duration,
                    type: 'between_events'
                });
                console.log(`Gap between events: ${gapStart.toLocaleTimeString()} - ${gapEnd.toLocaleTimeString()} (${duration} min)`);
            }
        }

        // After last event
        const lastEvent = dayEvents[dayEvents.length - 1];
        if (lastEvent.end < dayEnd) {
            const duration = (dayEnd - lastEvent.end) / (1000 * 60);
            if (duration >= minDuration) {
                gaps.push({
                    start: lastEvent.end,
                    end: dayEnd,
                    duration: duration,
                    type: 'after_last'
                });
                console.log(`Gap after last event: ${lastEvent.end.toLocaleTimeString()} - ${dayEnd.toLocaleTimeString()} (${duration} min)`);
            }
        }
    }

    console.log(`Found ${gaps.length} gaps on ${targetDateStr}`);
    return gaps;
}

function hasConflict(slot, events) {
    // FIX: The error "Invalid time value" was caused by manually adding a timezone
    // offset ("+03:00"). While this might work in some browsers, it's not a
    // universally recognized standard and can fail in different JavaScript environments.
    // The robust solution is to pass the local time string (e.g., "2025-08-29T14:00:00")
    // directly to the Date constructor. The JavaScript engine correctly interprets
    // this as a local time in the environment where the code is running.
    // Since the calendar event times are full ISO strings with timezone info,
    // the comparison between the two types of dates remains accurate.
    const slotStart = new Date(slot.startTime);
    const slotEnd = new Date(slot.endTime);

    console.log(`🔍 Checking conflicts for slot: ${slotStart.toLocaleString()} - ${slotEnd.toLocaleString()}`);

    const conflicts = [];
    for (const event of events) {
        if (!event.start || !event.end) continue;

        const eventStart = new Date(event.start.dateTime || event.start.date);
        const eventEnd = new Date(event.end.dateTime || event.end.date);

        console.log(`📅 Checking against event: "${event.summary}" ${eventStart.toLocaleString()} - ${eventEnd.toLocaleString()}`);

        if (slotStart < eventEnd && slotEnd > eventStart) {
            conflicts.push({
                eventTitle: event.summary,
                eventStart: event.start.dateTime,
                eventEnd: event.end.dateTime
            });
            console.log(`❌ CONFLICT DETECTED with "${event.summary}"`);
        }
    }

    console.log(`Conflicts found: ${conflicts.length}`);
    slot.conflictDetails = conflicts;
    return conflicts.length > 0;
}

// Timezone-safe helper function to get YYYY-MM-DD from a Date object
function getLocalDateString(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
}

// CRITICAL: Universal past-time validation
function isSlotInPast(slot, bufferMinutes = 0) {
    const now = new Date();
    const slotStart = new Date(slot.startTime);
    const cutoff = new Date(now.getTime() + bufferMinutes * 60 * 1000);
    
    const isPast = slotStart <= cutoff;
    
    if (isPast) {
        console.log(`🚫 PAST SLOT DETECTED:`);
        console.log(`   Now: ${now.toLocaleString()}`);
        console.log(`   Slot: ${slotStart.toLocaleString()}`);
        console.log(`   Cutoff (with buffer): ${cutoff.toLocaleString()}`);
        console.log(`   Slot is ${Math.round((cutoff - slotStart) / (1000 * 60))} minutes in the past`);
    }
    
    return isPast;
}

// Fix date interpretation for day names (Friday should be NEXT Friday if today is Friday)
function getNextOccurrenceOfDay(dayName, referenceDate = new Date()) {
    const dayMap = {
        'sunday': 0, 'monday': 1, 'tuesday': 2, 'wednesday': 3, 
        'thursday': 4, 'friday': 5, 'saturday': 6,
        'یکشنبه': 0, 'دوشنبه': 1, 'سه‌شنبه': 2, 'چهارشنبه': 3,
        'پنج‌شنبه': 4, 'جمعه': 5, 'شنبه': 6
    };
    
    const targetDay = dayMap[dayName.toLowerCase()];
    if (targetDay === undefined) return null;
    
    const today = referenceDate.getDay();
    let daysToAdd = targetDay - today;
    
    // If it's the same day, move to next week
    if (daysToAdd <= 0) {
        daysToAdd += 7;
    }
    
    const nextOccurrence = new Date(referenceDate);
    nextOccurrence.setDate(nextOccurrence.getDate() + daysToAdd);
    
    console.log(`📅 Day interpretation: "${dayName}" → Next ${Object.keys(dayMap)[targetDay]} (${nextOccurrence.toDateString()})`);
    return nextOccurrence;
}


// STEP 6: Master Slot Finding Algorithm
function findOptimalSlot(task, events, userTimezone, originalMessage) {
    console.log(`\n=== FINDING SLOT FOR: "${task.description}" ===`);

    const intent = parseUserIntent(originalMessage, task);
    const targetDate = determineTargetDate(task, intent);
    const buffer = calculateBuffer(task, intent);
    const preferredHours = getCategoryTimePreferences(task, intent);
    const duration = task.estimated_duration || 60;

    console.log(`Target date: ${targetDate.toDateString()}`);
    console.log(`Buffer required: ${buffer} minutes`);
    console.log(`Preferred hours: ${preferredHours.join(', ')}`);

    const now = new Date();
    const bufferCutoff = new Date(now.getTime() + buffer * 60 * 1000);

    // PRIORITY 1: Handle explicit time requests
    if (intent.hasSpecificTime) {
        console.log('🎯 EXPLICIT TIME REQUEST - attempting to honor');
        console.log(`Requested time: ${task.time}`);
        console.log(`Requested date: ${task.due_date || 'none (will use target date)'}`);
        
        const requestedDate = intent.hasSpecificDate ? targetDate : now;
        // FIX: Use the timezone-safe helper function to prevent UTC conversion errors.
        const dateStr = getLocalDateString(requestedDate);

        console.log(`Final requested date string: ${dateStr}`);
        console.log(`Creating slot for: ${dateStr}T${task.time}:00`);

        const explicitSlot = createTimeSlotInUserTimezone(dateStr, task.time, duration);

        console.log(`Created explicit slot: ${explicitSlot.startTime} - ${explicitSlot.endTime}`);

        // CRITICAL: Check if the slot is in the past FIRST
        if (isSlotInPast(explicitSlot, buffer)) {
            console.log('🚫 REQUESTED TIME IS IN THE PAST - finding future alternative');
            
            // If user requested a specific day + time, try same time on next week
            if (intent.hasSpecificDate) {
                const nextWeekDate = new Date(requestedDate);
                nextWeekDate.setDate(nextWeekDate.getDate() + 7);
                const nextWeekDateStr = getLocalDateString(nextWeekDate);
                
                console.log(`🔄 Trying same time next week: ${nextWeekDateStr} at ${task.time}`);
                const nextWeekSlot = createTimeSlotInUserTimezone(nextWeekDateStr, task.time, duration);
                
                if (!isSlotInPast(nextWeekSlot, buffer) && !hasConflict(nextWeekSlot, events)) {
                    console.log('✅ NEXT WEEK SLOT WORKS');
                    return {
                        ...nextWeekSlot,
                        isPreferred: true,
                        hasConflict: false,
                        strategyUsed: 'explicit_time_next_week',
                        dayOffset: 7,
                        taskDescription: task.description,
                        adjustmentNote: 'Moved to next week because requested time was in the past'
                    };
                }
            }
            
            // Fallback: find next available slot
            console.log('🔄 Finding next available future slot...');
            // Fall through to the general search logic below
        } else {
            // Original logic for non-past slots
            // Check if it violates buffer (only for same day)
            const isToday = dateStr === getLocalDateString(now);
            const slotTime = new Date(explicitSlot.startTime);

            console.log(`Is today: ${isToday}, Slot time: ${slotTime.toLocaleString()}, Buffer cutoff: ${bufferCutoff.toLocaleString()}`);

            if (!isToday || slotTime > bufferCutoff) {
                console.log('✅ Time slot is valid (not violating buffer rules)');
                
                // Check for conflicts with detailed logging
                const hasConflicts = hasConflict(explicitSlot, events);
                
                if (!hasConflicts) {
                    console.log('✅ EXPLICIT TIME HONORED - No conflicts found');
                    return {
                        ...explicitSlot,
                        isPreferred: true,
                        hasConflict: false,
                        strategyUsed: 'explicit_time_request',
                        dayOffset: Math.floor((requestedDate - now) / (1000 * 60 * 60 * 24)),
                        taskDescription: task.description
                    };
                } else {
                    console.log('❌ EXPLICIT TIME HAS CONFLICTS - attempting to resolve by adjusting time');
                    
                    // Try to resolve conflict by adjusting time ±1 hour
                    const resolvedSlot = tryResolveTimeConflict(explicitSlot, events, task, dateStr, duration);
                    
                    if (resolvedSlot && !isSlotInPast(resolvedSlot, buffer)) {
                        console.log('✅ CONFLICT RESOLVED - Found alternative time');
                        return {
                            ...resolvedSlot,
                            isPreferred: false, // Not exactly preferred since it was adjusted
                            hasConflict: false,
                            strategyUsed: 'explicit_time_adjusted',
                            dayOffset: Math.floor((requestedDate - now) / (1000 * 60 * 60 * 24)),
                            taskDescription: task.description,
                            adjustmentNote: 'Time adjusted by ±1 hour to avoid conflicts'
                        };
                    }
                    
                    console.log('❌ CONFLICT UNRESOLVABLE - no suitable adjustment found');
                    
                    // If we can't resolve the conflict, return with conflict details
                    return {
                        ...explicitSlot,
                        isPreferred: true,
                        hasConflict: true,
                        strategyUsed: 'explicit_time_with_conflict',
                        dayOffset: Math.floor((requestedDate - now) / (1000 * 60 * 60 * 24)),
                        taskDescription: task.description,
                        warning: 'CONFLICT: Your requested time conflicts with existing events',
                        conflictingEvents: explicitSlot.conflictDetails || []
                    };
                }
            } else {
                console.log('❌ EXPLICIT TIME VIOLATES BUFFER - will find alternative on same day');
                
                // Try to find alternative slot on the same requested date
                console.log(`🔄 Searching for alternative slots on ${dateStr}`);
                const sameDayGaps = findAvailableGaps(events, dateStr, duration);
                
                if (sameDayGaps.length > 0) {
                    console.log(`Found ${sameDayGaps.length} alternative gaps on same day`);
                    const bestSameDayGap = sameDayGaps[0];
                    const alternativeTime = findOptimalTimeInGap(bestSameDayGap, duration, preferredHours, intent);
                    const alternativeSlot = createTimeSlotInUserTimezone(dateStr, alternativeTime, duration);
                    
                    if (!hasConflict(alternativeSlot, events) && !isSlotInPast(alternativeSlot, buffer)) {
                        console.log('✅ Found conflict-free alternative on same day');
                        return {
                            ...alternativeSlot,
                            isPreferred: false,
                            hasConflict: false,
                            strategyUsed: 'explicit_date_alternative_time',
                            dayOffset: Math.floor((requestedDate - now) / (1000 * 60 * 60 * 24)),
                            taskDescription: task.description,
                            originalRequestedTime: task.time,
                            adjustmentReason: 'Moved to avoid buffer violation but kept same day'
                        };
                    }
                }
                
                console.log('❌ No suitable same-day alternative found');
            }
        }
    }

    // PRIORITY 2: Search within appropriate window
    const maxDays = intent.isUrgent ? 1 : (intent.isToday ? 1 : 7);
    const allGapsWithScores = [];

    // CRITICAL FIX: For explicit date requests, prioritize the requested date heavily
    if (intent.hasSpecificDate) {
        console.log('🎯 EXPLICIT DATE REQUEST - prioritizing requested date heavily');
        
        // Search the requested date first with detailed logging
        const requestedDateStr = getLocalDateString(targetDate);
        console.log(`\n🎯 Priority Search - Requested Date: ${requestedDateStr}`);
        
        const requestedDateGaps = findAvailableGaps(events, requestedDateStr, duration + buffer);
        
        for (const gap of requestedDateGaps) {
            const score = scoreGap(gap, task, intent, preferredHours, targetDate);
            allGapsWithScores.push({
                gap: gap,
                score: score,
                dayOffset: 0,
                dateStr: requestedDateStr,
                isRequestedDate: true
            });
        }
        
        // Only search other days if no suitable gaps found on requested date
        if (allGapsWithScores.length === 0) {
            console.log('❌ No gaps found on requested date, searching alternatives...');
        } else {
            console.log(`✅ Found ${allGapsWithScores.length} gaps on requested date`);
            // For explicit dates, don't search other days unless requested date has no viable options
            const viableGaps = allGapsWithScores.filter(g => g.score > 0);
            if (viableGaps.length > 0) {
                console.log('✅ Viable gaps found on requested date - skipping other days');
                // Skip the general search loop
            } else {
                console.log('⚠️ No viable gaps on requested date - will search alternatives');
                allGapsWithScores.length = 0; // Clear low-scoring gaps
            }
        }
    }

    // General search for non-explicit dates OR when explicit date has no viable options
    if (!intent.hasSpecificDate || allGapsWithScores.length === 0) {
        for (let dayOffset = 0; dayOffset < maxDays; dayOffset++) {
            const searchDate = new Date(targetDate);
            searchDate.setDate(searchDate.getDate() + dayOffset);
            // FIX: Use the timezone-safe helper function here as well.
            const dateStr = getLocalDateString(searchDate);

            console.log(`\nSearching day ${dayOffset}: ${dateStr}`);

            const gaps = findAvailableGaps(events, dateStr, duration + buffer);

            for (const gap of gaps) {
                // Apply buffer constraints for same day
                // FIX: Ensure 'today' is checked accurately against the local date.
                const isToday = dateStr === getLocalDateString(now);
                let effectiveGap = gap;

                if (isToday && gap.start < bufferCutoff) {
                    if (gap.end <= bufferCutoff) {
                        console.log('Gap entirely within buffer, skipping');
                        continue; // Entire gap is within buffer
                    }

                    // Adjust gap to start after buffer
                    effectiveGap = {
                        ...gap,
                        start: bufferCutoff,
                        duration: (gap.end - bufferCutoff) / (1000 * 60)
                    };

                    if (effectiveGap.duration < duration) {
                        console.log('Adjusted gap too small, skipping');
                        continue;
                    }
                }

                const score = scoreGap(effectiveGap, task, intent, preferredHours, targetDate);
                allGapsWithScores.push({
                    gap: effectiveGap,
                    score: score,
                    dayOffset: dayOffset,
                    dateStr: dateStr,
                    isRequestedDate: false
                });
            }
        }
    }

    // STEP 7: Select best gap and time within it
    if (allGapsWithScores.length === 0) {
        return handleNoSuitableSlot(task, intent, events, targetDate, userTimezone);
    }

    // Sort by score (highest first)
    allGapsWithScores.sort((a, b) => b.score - a.score);

    // Debug: Show top 3 scoring gaps
    console.log('\n📊 TOP SCORING GAPS:');
    const topGaps = allGapsWithScores.slice(0, 3);
    topGaps.forEach((gapData, index) => {
        const gap = gapData.gap;
        console.log(`${index + 1}. ${gapData.dateStr} ${gap.start.toLocaleTimeString()} - ${gap.end.toLocaleTimeString()} | Score: ${gapData.score} | Requested Date: ${gapData.isRequestedDate ? 'YES' : 'NO'}`);
    });

    const bestGapData = allGapsWithScores[0];
    const bestGap = bestGapData.gap;

    console.log(`\nSelected best gap (score: ${bestGapData.score}) on ${bestGapData.dateStr}`);
    if (bestGapData.isRequestedDate) {
        console.log('✅ SUCCESS: Selected gap is on the requested date!');
    } else {
        console.log('⚠️ FALLBACK: Selected gap is NOT on requested date');
    }

    // Find optimal time within the best gap
    const optimalTime = findOptimalTimeInGap(bestGap, duration, preferredHours, intent);
    const slot = createTimeSlotInUserTimezone(bestGapData.dateStr, optimalTime, duration);

    // CRITICAL: Final past-time validation
    if (isSlotInPast(slot, buffer)) {
        console.log('🚫 FINAL SLOT IS IN THE PAST - rejecting');
        return handleNoSuitableSlot(task, intent, events, targetDate, userTimezone);
    }

    // Final conflict check
    if (hasConflict(slot, events)) {
        console.log('❌ Selected slot has conflicts - trying next best gap');
        // Try next best gap
        if (allGapsWithScores.length > 1) {
            return tryNextBestGap(allGapsWithScores.slice(1), duration, preferredHours, intent, events, buffer);
        }
        return handleNoSuitableSlot(task, intent, events, targetDate, userTimezone);
    }

    console.log('✅ OPTIMAL SLOT FOUND');
    return {
        ...slot,
        isPreferred: preferredHours.slice(0, 2).includes(parseInt(optimalTime.split(':')[0])),
        hasConflict: false,
        strategyUsed: intent.isToday ? 'same_day_enforced' : 'optimal_gap_selection',
        dayOffset: bestGapData.dayOffset,
        taskDescription: task.description,
        gapType: bestGap.type,
        gapDuration: bestGap.duration,
        gapScore: bestGapData.score
    };
}

// Helper: Find optimal time within selected gap
function findOptimalTimeInGap(gap, duration, preferredHours, intent) {
    const gapStartMinutes = gap.start.getHours() * 60 + gap.start.getMinutes();
    const gapEndMinutes = gap.end.getHours() * 60 + gap.end.getMinutes() - duration;

    // Try preferred hours in order
    for (const hour of preferredHours) {
        const hourMinutes = hour * 60;
        if (hourMinutes >= gapStartMinutes && hourMinutes <= gapEndMinutes) {
            return `${String(hour).padStart(2, '0')}:00`;
        }

        // Try half-hour slots too
        const halfHourMinutes = hourMinutes + 30;
        if (halfHourMinutes >= gapStartMinutes && halfHourMinutes <= gapEndMinutes) {
            return `${String(hour).padStart(2, '0')}:30`;
        }
    }

    // If no preferred time fits, use start of gap with small buffer
    const bufferMinutes = Math.min(15, Math.floor(gap.duration / 6));
    const startMinutes = gapStartMinutes + bufferMinutes;
    const hours = Math.floor(startMinutes / 60);
    const minutes = startMinutes % 60;

    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
}

// Helper: Try next best gaps if primary fails
function tryNextBestGap(remainingGaps, duration, preferredHours, intent, events, buffer = 0) {
    for (const gapData of remainingGaps) {
        const optimalTime = findOptimalTimeInGap(gapData.gap, duration, preferredHours, intent);
        const slot = createTimeSlotInUserTimezone(gapData.dateStr, optimalTime, duration);

        // Check both conflicts AND past-time
        if (!hasConflict(slot, events) && !isSlotInPast(slot, buffer)) {
            return {
                ...slot,
                isPreferred: false,
                hasConflict: false,
                strategyUsed: 'backup_gap_selection',
                dayOffset: gapData.dayOffset,
                gapType: gapData.gap.type,
                gapDuration: gapData.gap.duration,
                gapScore: gapData.score
            };
        } else {
            console.log(`❌ Gap rejected: conflicts=${hasConflict(slot, events)}, inPast=${isSlotInPast(slot, buffer)}`);
        }
    }
    return null;
}

// STEP 8: Handle no suitable slot scenarios
function handleNoSuitableSlot(task, intent, events, targetDate, userTimezone) {
    console.log('🚨 NO SUITABLE SLOT FOUND - applying emergency logic');

    if (intent.isUrgent) {
        console.log('URGENT TASK - forcing slot with conflict warning');
        // Force a slot in the next available gap, even with conflicts
        const tomorrow = new Date(targetDate);
        tomorrow.setDate(tomorrow.getDate() + 1);
        // FIX: Use timezone-safe helper for date string.
        const dateStr = getLocalDateString(tomorrow);

        const emergencySlot = createTimeSlotInUserTimezone(dateStr, "09:00", task.estimated_duration || 60);
        return {
            ...emergencySlot,
            isPreferred: false,
            hasConflict: true,
            strategyUsed: 'urgent_force',
            dayOffset: 1,
            taskDescription: task.description,
            warning: 'URGENT: Forced scheduling - may conflict with existing events'
        };
    }

    // Extend search to 14 days for non-urgent tasks
    console.log('Extending search to 14 days...');

    for (let dayOffset = 7; dayOffset < 14; dayOffset++) {
        const searchDate = new Date(targetDate);
        searchDate.setDate(searchDate.getDate() + dayOffset);
        // FIX: Use timezone-safe helper for date string.
        const dateStr = getLocalDateString(searchDate);

        const gaps = findAvailableGaps(events, dateStr, task.estimated_duration || 60);
        if (gaps.length > 0) {
            const firstGap = gaps[0];
            const timeInGap = findOptimalTimeInGap(firstGap, task.estimated_duration || 60,
                getCategoryTimePreferences(task, intent), intent);

            const slot = createTimeSlotInUserTimezone(dateStr, timeInGap, task.estimated_duration || 60);

            return {
                ...slot,
                isPreferred: false,
                hasConflict: false,
                strategyUsed: 'extended_search',
                dayOffset: dayOffset,
                taskDescription: task.description,
                gapType: firstGap.type,
                warning: 'Scheduled far in advance due to busy calendar'
            };
        }
    }

    // Ultimate fallback
    console.log('❌ ULTIMATE FALLBACK');
    const fallbackDate = new Date(targetDate);
    fallbackDate.setDate(fallbackDate.getDate() + 14);
    // FIX: Use timezone-safe helper for date string.
    const dateStr = getLocalDateString(fallbackDate);

    const fallbackSlot = createTimeSlotInUserTimezone(dateStr, "09:00", task.estimated_duration || 60);
    return {
        ...fallbackSlot,
        isPreferred: false,
        hasConflict: true,
        strategyUsed: 'ultimate_fallback',
        dayOffset: 14,
        taskDescription: task.description,
        error: 'Could not find suitable slot - please review calendar manually'
    };
}

function generateResolutionReason(slot, task, originalMessage) {
    if (!task || !slot) {
        return 'Unable to generate resolution reason - missing task or slot data';
    }
    
    const intent = parseUserIntent(originalMessage, task);
    const reasons = [];

    if (slot.strategyUsed === 'explicit_time_request') {
        reasons.push("Honored your specific time request");
    } else if (slot.strategyUsed === 'same_day_enforced') {
        reasons.push("Scheduled for today as explicitly requested");
    } else if (slot.strategyUsed === 'optimal_gap_selection') {
        reasons.push(`Found optimal ${slot.gapType} gap (${Math.floor(slot.gapDuration)} min available)`);
        if (slot.isPreferred) {
            reasons.push("time matches your task category preferences");
        }
    } else if (slot.strategyUsed === 'urgent_force') {
        reasons.push("URGENT scheduling - may require calendar adjustments");
    }

    if (slot.dayOffset === 0 && intent.isToday) {
        reasons.push("successfully scheduled for same day");
    } else if (slot.dayOffset > 0) {
        reasons.push(`moved ${slot.dayOffset} day${slot.dayOffset > 1 ? 's' : ''} ahead`);
    }

    return reasons.length > 0 ? reasons.join('; ') : 'Standard optimal scheduling';
}

