        return false;
    }
    
    // Categories that benefit from optimal timing (postponable)
    const postponableCategories = [
        'learning',        // Better concentration matters
        'content work',    // Creativity peak matters
        'creative',        // Creative flow matters
        'general work',    // Flexible timing
        'personal'         // Usually flexible
    ];
    
    if (postponableCategories.includes(task.category)) {
        console.log(`✅ Can postpone: ${task.category} benefits from optimal timing`);
